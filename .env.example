# Lokal (MinIO = S3 uyumlu). Gerçek AWS için S3_ENDPOINT'i boş bırakıp gerçek key'leri yaz.
S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=market-data
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=market.ticks
DW_JDBC_URL=jdbc:postgresql://postgres-dw:5432/market_dw
DW_USER=dw
DW_PASSWORD=dw
